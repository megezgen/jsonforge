{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jsonforge",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "jsonforge.dev", "custom_domain": true },
    { "pattern": "www.jsonforge.dev", "custom_domain": true }
  ]
}
