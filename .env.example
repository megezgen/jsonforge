# Public origin of the deployed site, no trailing slash. Used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional. Shown on the About, Privacy and Terms pages when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Set to true once an ad network has approved the site to show the reserved ad slots.
NEXT_PUBLIC_ADS_ENABLED=false

# Optional. Donation or sponsorship page (GitHub Sponsors, Buy Me a Coffee...). The footer link stays hidden when empty.
NEXT_PUBLIC_SUPPORT_URL=
